/*
 * Friuli case (VAL-3, phase 2 of the prototype plan): snow on four stations of
 * the Friuli Venezia Giulia network, 1 November 2025 - 1 May 2026, hourly,
 * recommended configuration, against the observed snow depth.
 *
 * Inputs from the MobyGIS-GEOtop point run pysnow/tests/gt_sim1D, written by
 * make_inputs.py: air temperature, relative humidity, wind (5 m), pressure,
 * total precipitation, and the cloud transmissivity TAU_CLD in place of the
 * radiation (no radiation is measured: GEOtop's clear-sky shortwave times
 * TAU_CLD, longwave of Konzelmann 1994 as LWinParameterization = 7 of the
 * GEOtop runs). Soil: GEOtop's three layers of 0.28, 0.50, 2.00 m, heat only
 * (soilWaterMode Fixed, as WaterBalance = 0), 1 degC, water table at 1 m,
 * no heat flux at the bottom (GEOtop's default). Flat ground: no slope, no
 * horizon (LINK-4). Rain/snow ramp 0.5-2.0 degC as the GEOtop runs.
 *
 * One station per run, chosen with -Dstation=1..4 (default 1). Run from the
 * root of the repository, with oms-3.5.12.jar FIRST on the classpath:
 *
 *   mvn -q -o compile dependency:build-classpath -Dmdep.outputFile=cp.txt
 *   java -Dstation=1 -Doms.prj=$PWD/cases/snowsoil/friuli \
 *        -cp ~/.m2/repository/edu/colostate/omslab/oms/3.5.12/oms-3.5.12.jar:target/classes:$(cat cp.txt) \
 *        oms3.CLI -r cases/snowsoil/friuli/snowsoil_friuli.sim
 *
 * or cases/snowsoil/friuli/run_all.sh for the four stations. Outputs in
 * output/station_<n>/ (NetCDF and GEOtop-like CSV). With
 * -Dstability="Unstable only" the stability correction of the GEOtop runs
 * (MoninObukhov = 2) replaces the configuration's, outputs in
 * output/station_<n>_unstable_only/: a sensitivity run, not the reference.
 */
import oms3.SimBuilder as OMS3

def station = (System.getProperty("station") ?: "1") as int
// optional: -Dstability="Unstable only" (GEOtop MoninObukhov = 2, the option of the GEOtop runs); empty: the configuration's
def stability = System.getProperty("stability") ?: ""
// optional: -DshortwavePenetration=None (all the net shortwave at the surface, SNOW-7); empty: the configuration's
def shortwavePenetration = System.getProperty("shortwavePenetration") ?: ""
def suffix = (stability ? "_" + stability.toLowerCase().replace(" ", "_") : "") + (shortwavePenetration ? "_sw_" + shortwavePenetration.toLowerCase() : "")
// latitude, longitude, elevation of the stations (one line each: the OMS preprocessor reads def lines one by one)
def latitude  = [1: 46.4518, 2: 46.46722, 3: 46.4662, 4: 46.48414][station]
def longitude = [1: 12.62653, 2: 12.68198, 3: 12.71044, 4: 12.72301][station]
def elevation = [1: 1710.0, 2: 1414.0, 3: 1200.0, 4: 1742.0][station]

def startDate = "2025-11-01 01:00"
def endDate   = "2026-05-01 00:00"
def timestep  = 60
def data = "$oms_prj/data"

new OMS3().sim(name: "snowsoil_friuli_${station}") {

    model(while: "reader_airT.doProcess") {

        components {
            "reader_airT"  "org.hortonmachine.gears.io.timedependent.OmsTimeSeriesIteratorReader"
            "reader_rh"    "org.hortonmachine.gears.io.timedependent.OmsTimeSeriesIteratorReader"
            "reader_wind"  "org.hortonmachine.gears.io.timedependent.OmsTimeSeriesIteratorReader"
            "reader_p"     "org.hortonmachine.gears.io.timedependent.OmsTimeSeriesIteratorReader"
            "reader_prec"  "org.hortonmachine.gears.io.timedependent.OmsTimeSeriesIteratorReader"
            "reader_tau"   "org.hortonmachine.gears.io.timedependent.OmsTimeSeriesIteratorReader"
            "snowsoil"     "org.geoframe.whetgeo1d.solvers.SnowSoilSolver1DMain"
        }

        parameter {
            "reader_airT.file"         "${data}/airTemperature.csv"
            "reader_airT.idfield"      "ID"
            "reader_airT.tStart"       "${startDate}"
            "reader_airT.tEnd"         "${endDate}"
            "reader_airT.tTimestep"    "${timestep}"
            "reader_airT.fileNovalue"  "-9999.0"

            "reader_rh.file"           "${data}/relativeHumidity.csv"
            "reader_rh.idfield"        "ID"
            "reader_rh.tStart"         "${startDate}"
            "reader_rh.tEnd"           "${endDate}"
            "reader_rh.tTimestep"      "${timestep}"
            "reader_rh.fileNovalue"    "-9999.0"

            "reader_wind.file"         "${data}/windSpeed.csv"
            "reader_wind.idfield"      "ID"
            "reader_wind.tStart"       "${startDate}"
            "reader_wind.tEnd"         "${endDate}"
            "reader_wind.tTimestep"    "${timestep}"
            "reader_wind.fileNovalue"  "-9999.0"

            "reader_p.file"            "${data}/pressure.csv"
            "reader_p.idfield"         "ID"
            "reader_p.tStart"          "${startDate}"
            "reader_p.tEnd"            "${endDate}"
            "reader_p.tTimestep"       "${timestep}"
            "reader_p.fileNovalue"     "-9999.0"

            "reader_prec.file"         "${data}/precipitation.csv"
            "reader_prec.idfield"      "ID"
            "reader_prec.tStart"       "${startDate}"
            "reader_prec.tEnd"         "${endDate}"
            "reader_prec.tTimestep"    "${timestep}"
            "reader_prec.fileNovalue"  "-9999.0"

            "reader_tau.file"          "${data}/cloudTransmissivity.csv"
            "reader_tau.idfield"       "ID"
            "reader_tau.tStart"        "${startDate}"
            "reader_tau.tEnd"          "${endDate}"
            "reader_tau.tTimestep"     "${timestep}"
            "reader_tau.fileNovalue"   "-9999.0"

            // configuration (ARCH-6): the plan runs Friuli in the recommended configuration
            "snowsoil.configuration"          "recommended"
            "snowsoil.soilWaterMode"          "Fixed"
            "snowsoil.stabilityCorrection"    "${stability}"
            "snowsoil.shortwavePenetration"   "${shortwavePenetration}"
            "snowsoil.windHeight"             5.0
            "snowsoil.temperatureHeight"      2.0

            // site
            "snowsoil.stationID"              station
            "snowsoil.latitude"               latitude
            "snowsoil.longitude"              longitude
            "snowsoil.standardTime"           0.0
            "snowsoil.elevation"              elevation
            "snowsoil.tTimeStep"              3600.0

            // longwave as LWinParameterization = 7 of the GEOtop runs
            "snowsoil.clearSkyEmissivity"     "Konzelmann 1994"

            // soil grid: GEOtop's three layers, WHETGEO-1D CSV inputs
            "snowsoil.soilGridFile"           "$oms_prj/grid"

            // boundary conditions (COL-6): bare soil by bulk transfer, no flux at the bottom
            "snowsoil.bareSoilTopType"        "Bulk Transfer"
            "snowsoil.bareSoilTransfer"       10.0
            "snowsoil.bottomBCType"           "Bottom No Gradient"

            // precipitation split, GEOtop's ramp with the thresholds of the case [degC]
            "snowsoil.precipitationPartition" "Geotop Linear"
            "snowsoil.rainThreshold"          2.0
            "snowsoil.snowThreshold"          0.5

            // run header and outputs
            "snowsoil.inputFiles"             "${data}/airTemperature.csv,${data}/relativeHumidity.csv,${data}/windSpeed.csv,${data}/pressure.csv,${data}/precipitation.csv,${data}/cloudTransmissivity.csv"
            "snowsoil.outputPath"             "$oms_prj/output/station_${station}${suffix}"
        }

        connect {
            "reader_airT.outData"   "snowsoil.inAirTemperature"
            "reader_rh.outData"     "snowsoil.inRelativeHumidity"
            "reader_wind.outData"   "snowsoil.inWindSpeed"
            "reader_p.outData"      "snowsoil.inPressure"
            "reader_prec.outData"   "snowsoil.inPrecipitation"
            "reader_tau.outData"    "snowsoil.inCloudTransmissivity"
            "reader_airT.tCurrent"  "snowsoil.inCurrentDate"
        }
    }
}
