/*
 * Canadian case NTGS1 / NTGS2 x ERA5 / JRA-3Q (phase 2.1): the snow+soil column in
 * the fidelity configuration, heat only, against GEOtop 3.0 without canopy,
 * corrected (casi/Canada_NTGS/sims/<case>_senza_chioma_corretta of the GEO2GEO
 * workspace). See README.md.
 *
 * One case per run, chosen with -Dcase=NTGS1_ERA5 (default), NTGS1_JR3QG,
 * NTGS2_ERA5 or NTGS2_JR3QG; run.sh writes the forcing and runs the four.
 *
 * Forcing: data/<case>/*.csv, hourly, written by run.sh with the temporary
 * fidelity tools (GeotopForcingFiles) from GEOtop's own input files, as GEOtop
 * steps and computes them: precipitation x cos(slope) once and split on
 * 1 / -3 degC, shortwave on the slope, the reanalysis longwave as it is, the
 * pressure of the standard atmosphere at the site. Bare soil: GEOtop's
 * Tsurface as a Dirichlet top (fallback: no bare-soil energy balance in the
 * column).
 *
 * Soil: the 20 layers of soil0001.txt to 9.03 m in eta, one parameter set per
 * layer, Dall'Amico freezing, theta from GEOtop's InitPres kept fixed
 * (soilWaterMode Fixed, as WaterBalance = 0), T(0) = InitTemp per layer
 * (GEOtop 2.0 profile at 01/09/2020), zero heat flux at the bottom.
 */
import oms3.SimBuilder as OMS3

def caseName  = System.getProperty("case") ?: "NTGS1_ERA5"
def site      = caseName.substring(0, 5)
// latitude, longitude, elevation, slope of the sites (siti.py); one line each: the OMS preprocessor reads def lines one by one
def latitude  = ["NTGS1": 68.538402, "NTGS2": 68.537861][site]
def longitude = ["NTGS1": -133.773038, "NTGS2": -133.762289][site]
def elevation = ["NTGS1": 96.0, "NTGS2": 107.0][site]
def slope     = ["NTGS1": 30.0, "NTGS2": 35.0][site]
def startDate = "2020-09-01 01:00"
def endDate   = System.getProperty("endDate") ?: "2023-09-01 00:00"
def timestep  = 60
def data = "$oms_prj/data/${caseName}"
// optional overrides for sensitivity runs (not the reference): -DheatTolerance=..., -DonNonConvergence=Flag, -Dlabel=... (output/<case>_<label>/)
def heatTolerance = (System.getProperty("heatTolerance") ?: "1e-3") as double
// the component's default: a step that does not converge stops the run, saving the last accepted state
def onNonConvergence = System.getProperty("onNonConvergence") ?: "Stop"
// -DskinNode=None: no skin node (sensitivity, GEOtop's HighestNodeCorrespondsToLayer = 1); empty: the configuration's
def skinNode = System.getProperty("skinNode") ?: ""
def label = System.getProperty("label") ? "_" + System.getProperty("label") : ""
// round-4 attribution runs: -DthinSnowRegime=None, -DporosityCap=Ice_Density, -DfaceConductance=Harmonic_Mean (empty: fidelity's)
def thinSnowRegime = (System.getProperty("thinSnowRegime") ?: "").replace("_", " ")
def porosityCap = (System.getProperty("porosityCap") ?: "").replace("_", " ")
def faceConductance = (System.getProperty("faceConductance") ?: "").replace("_", " ")

new OMS3().sim(name: "snowsoil_canada_ntgs") {

    model(while: "reader_airT.doProcess") {

        components {
            "reader_airT"    "org.hortonmachine.gears.io.timedependent.OmsTimeSeriesIteratorReader"
            "reader_rh"      "org.hortonmachine.gears.io.timedependent.OmsTimeSeriesIteratorReader"
            "reader_wind"    "org.hortonmachine.gears.io.timedependent.OmsTimeSeriesIteratorReader"
            "reader_p"       "org.hortonmachine.gears.io.timedependent.OmsTimeSeriesIteratorReader"
            "reader_rain"    "org.hortonmachine.gears.io.timedependent.OmsTimeSeriesIteratorReader"
            "reader_snow"    "org.hortonmachine.gears.io.timedependent.OmsTimeSeriesIteratorReader"
            "reader_swb"     "org.hortonmachine.gears.io.timedependent.OmsTimeSeriesIteratorReader"
            "reader_swd"     "org.hortonmachine.gears.io.timedependent.OmsTimeSeriesIteratorReader"
            "reader_cos"     "org.hortonmachine.gears.io.timedependent.OmsTimeSeriesIteratorReader"
            "reader_lw"      "org.hortonmachine.gears.io.timedependent.OmsTimeSeriesIteratorReader"
            "reader_ts"      "org.hortonmachine.gears.io.timedependent.OmsTimeSeriesIteratorReader"
            "snowsoil"      "org.geoframe.whetgeo1d.solvers.SnowSoilSolver1DMain"
        }

        parameter {
            "reader_airT.file"         "${data}/airTemperature.csv"
            "reader_airT.idfield"      "ID"
            "reader_airT.tStart"       "${startDate}"
            "reader_airT.tEnd"         "${endDate}"
            "reader_airT.tTimestep"    "${timestep}"
            "reader_airT.fileNovalue"  "-9999.0"

            "reader_rh.file"         "${data}/relativeHumidity.csv"
            "reader_rh.idfield"      "ID"
            "reader_rh.tStart"       "${startDate}"
            "reader_rh.tEnd"         "${endDate}"
            "reader_rh.tTimestep"    "${timestep}"
            "reader_rh.fileNovalue"  "-9999.0"

            "reader_wind.file"         "${data}/windSpeed.csv"
            "reader_wind.idfield"      "ID"
            "reader_wind.tStart"       "${startDate}"
            "reader_wind.tEnd"         "${endDate}"
            "reader_wind.tTimestep"    "${timestep}"
            "reader_wind.fileNovalue"  "-9999.0"

            "reader_p.file"         "${data}/pressure.csv"
            "reader_p.idfield"      "ID"
            "reader_p.tStart"       "${startDate}"
            "reader_p.tEnd"         "${endDate}"
            "reader_p.tTimestep"    "${timestep}"
            "reader_p.fileNovalue"  "-9999.0"

            "reader_rain.file"         "${data}/rainfall.csv"
            "reader_rain.idfield"      "ID"
            "reader_rain.tStart"       "${startDate}"
            "reader_rain.tEnd"         "${endDate}"
            "reader_rain.tTimestep"    "${timestep}"
            "reader_rain.fileNovalue"  "-9999.0"

            "reader_snow.file"         "${data}/snowfall.csv"
            "reader_snow.idfield"      "ID"
            "reader_snow.tStart"       "${startDate}"
            "reader_snow.tEnd"         "${endDate}"
            "reader_snow.tTimestep"    "${timestep}"
            "reader_snow.fileNovalue"  "-9999.0"

            "reader_swb.file"         "${data}/shortwaveDirect.csv"
            "reader_swb.idfield"      "ID"
            "reader_swb.tStart"       "${startDate}"
            "reader_swb.tEnd"         "${endDate}"
            "reader_swb.tTimestep"    "${timestep}"
            "reader_swb.fileNovalue"  "-9999.0"

            "reader_swd.file"         "${data}/shortwaveDiffuse.csv"
            "reader_swd.idfield"      "ID"
            "reader_swd.tStart"       "${startDate}"
            "reader_swd.tEnd"         "${endDate}"
            "reader_swd.tTimestep"    "${timestep}"
            "reader_swd.fileNovalue"  "-9999.0"

            "reader_cos.file"         "${data}/cosIncidence.csv"
            "reader_cos.idfield"      "ID"
            "reader_cos.tStart"       "${startDate}"
            "reader_cos.tEnd"         "${endDate}"
            "reader_cos.tTimestep"    "${timestep}"
            "reader_cos.fileNovalue"  "-9999.0"

            "reader_lw.file"         "${data}/longwaveIn.csv"
            "reader_lw.idfield"      "ID"
            "reader_lw.tStart"       "${startDate}"
            "reader_lw.tEnd"         "${endDate}"
            "reader_lw.tTimestep"    "${timestep}"
            "reader_lw.fileNovalue"  "-9999.0"

            "reader_ts.file"         "${data}/surfaceTemperature.csv"
            "reader_ts.idfield"      "ID"
            "reader_ts.tStart"       "${startDate}"
            "reader_ts.tEnd"         "${endDate}"
            "reader_ts.tTimestep"    "${timestep}"
            "reader_ts.fileNovalue"  "-9999.0"

            // fidelity configuration (GEOtop 3.0), Cosenza snow conductivity, MoninObukhov = 1 (both)
            "snowsoil.configuration"          "fidelity"
            // heat only: theta of GEOtop's initial pressure, fixed (WaterBalance = 0)
            "snowsoil.soilWaterMode"          "Fixed"
            // MeteoStationWindVelocitySensorHeight, MeteoStationTemperatureSensorHeight
            "snowsoil.windHeight"             10.0
            "snowsoil.temperatureHeight"      10.0
            "snowsoil.alphaSnow"              1e5
            "snowsoil.thinSnowRegime"         thinSnowRegime
            "snowsoil.porosityCap"            porosityCap
            "snowsoil.faceConductance"        faceConductance
            "snowsoil.heatTolerance"          heatTolerance
            "snowsoil.onNonConvergence"       onNonConvergence
            "snowsoil.skinNode"               skinNode
            "snowsoil.maxSnowCells"           10
            // the case's snow keywords of geotop.inpts (GeotopSnowParameters)
            "snowsoil.geotopSnowParameters"   "FreshSnowReflVis=0.9, FreshSnowReflNIR=0.65, AlbExtParSnow=10, IrriducibleWatSatSnow=0.02, SnowEmissiv=0.99, SnowRoughness=0.1, DrySnowDefRate=1, WetSnowDefRate=1.5, SnowDensityCutoff=100, SnowViscosity=1e6, MaxWaterEqSnowLayerContent=10, SWEbottom=20, SWEtop=20, MaxSnowLayersMiddle=4, PointSlope=${slope}"
            // soil albedos not set in geotop.inpts: GEOtop's default 0.2 (parameters.cc:1266)
            "snowsoil.groundAlbedo"             0.2
            "snowsoil.groundAlbedoNearInfrared" 0.2
            // GEOtop's thermal conductivity of water
            "snowsoil.thermalConductivityWater" 0.567

            // site
            "snowsoil.stationID"              1
            "snowsoil.latitude"               latitude
            "snowsoil.longitude"              longitude
            "snowsoil.standardTime"           0.0
            "snowsoil.elevation"              elevation
            "snowsoil.tTimeStep"              3600.0

            // soil: the 20 layers of soil0001.txt (grid/<case>, written by make_inputs.py)
            "snowsoil.soilGridFile"           "$oms_prj/grid/${caseName}"

            // bare soil at GEOtop's Tsurface (fallback); zero heat flux at the bottom (BottomBoundaryHeatFlux = 0)
            "snowsoil.bareSoilTopType"        "Dirichlet"
            "snowsoil.bottomBCType"           "Bottom Neumann"
            "snowsoil.bottomBCValue"          0.0

            "snowsoil.inputFiles"             "$oms_prj/geotop/${caseName}/forcing.properties,$oms_prj/geotop/${caseName}/meteo0001.txt.gz,$oms_prj/geotop/${caseName}/soil0001.txt,$oms_prj/geotop/${caseName}/reference.csv.gz"
            "snowsoil.outputPath"             "$oms_prj/output/${caseName}${label}"
            "snowsoil.outputInterval"         3600.0
            "snowsoil.outputStandardTime"     0.0
        }

        connect {
            "reader_airT.outData"   "snowsoil.inAirTemperature"
            "reader_rh.outData"     "snowsoil.inRelativeHumidity"
            "reader_wind.outData"   "snowsoil.inWindSpeed"
            "reader_p.outData"      "snowsoil.inPressure"
            "reader_rain.outData"   "snowsoil.inRainfall"
            "reader_snow.outData"   "snowsoil.inSnowfall"
            "reader_swb.outData"    "snowsoil.inShortwaveDirect"
            "reader_swd.outData"    "snowsoil.inShortwaveDiffuse"
            "reader_cos.outData"    "snowsoil.inCosIncidence"
            "reader_lw.outData"     "snowsoil.inLongwaveIn"
            "reader_ts.outData"     "snowsoil.inTopBC"
            "reader_airT.tCurrent"  "snowsoil.inCurrentDate"
        }
    }
}
