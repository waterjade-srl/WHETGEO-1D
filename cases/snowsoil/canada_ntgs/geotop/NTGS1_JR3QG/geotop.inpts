!=============================================================================
! Caso canadese NTGS1, forzanti JR3QG, variante senza_chioma, configurazione corretta — GEOtop 3.0
! Generato da build.py: non modificare a mano, cambiare siti.py o questo modello.
! Origine dei parametri: corse GEOtop 2.0 del gruppo (originali_geotop2/).
!=============================================================================

!--- Periodo e passo ----------------------------------------------------------
InitDateDDMMYYYYhhmm   = 01/09/2020 00:00
EndDateDDMMYYYYhhmm    = 01/09/2023 00:00
TimeStepEnergyAndWater = 3600
StandardTimeSimulation = 0
SuccessfulRunFile      = "_SUCCESSFUL_RUN"
FailedRunFile          = "_FAILED_RUN"

!--- Punto ---------------------------------------------------------------------
PointSim              = 1
! ActualOrProjectedArea = 1: una sola proiezione della precipitazione sul pendio
ActualOrProjectedArea = 1
Latitude              = 68.538402
Longitude             = -133.773038
PointElevation        = 96.0
PointSlope            = 30.0
PointAspect           = 0.0
PointLandCoverType    = 1
PointSoilType         = 1
HorizonPointFile      = "horizon/horizon"
HeaderHorizonAngle    = "azi"
HeaderHorizonHeight   = "hang"

!--- Processi (come le corse 2.0) ----------------------------------------------
EnergyBalance       = 1
! solo calore, contenuto d'acqua fisso
WaterBalance        = 0
MoninObukhov        = 1
FlagSkyViewFactor   = 1
CalculateCastShadow = 1
HeatEqTol           = 1.E-5
HeatEqMaxIter       = 1000
MinLambdaEnergy     = 1.E-12

!--- Stazione meteo ------------------------------------------------------------
NumberOfMeteoStation                  = 1
MeteoStationLatitude                  = 68.538402
MeteoStationLongitude                 = -133.773038
MeteoStationElevation                 = 96.0
MeteoStationStandardTime              = 0
MeteoStationWindVelocitySensorHeight  = 10
MeteoStationTemperatureSensorHeight   = 10
MeteoFile                   = "meteo/meteo"
HeaderDateDDMMYYYYhhmmMeteo = "Date"
HeaderIPrec                 = "IPrec"
HeaderWindVelocity          = "WindVelocity"
HeaderWindDirection         = "WindDirection"
HeaderRH                    = "RH"
HeaderAirTemp               = "AirTemp"
HeaderSWglobal              = "SWglobal"
! onda lunga della rianalisi
HeaderLWin                  = "LWin"
! La pressione delle forzanti non viene letta: GEOtop 3.0 la ricava dalla quota.
Vmin  = 0.5
RHmin = 10

!--- Neve --------------------------------------------------------------------------
ThresTempRain          = 1
ThresTempSnow          = -3
SnowCorrFactor         = 1
RainCorrFactor         = 1
AlbExtParSnow          = 10
FreshSnowReflVis       = 0.9
FreshSnowReflNIR       = 0.65
SnowEmissiv            = 0.99
SnowRoughness          = 0.1
PointMaxSWE            = 2000
MaxWaterEqSnowLayerContent = 10
SWEtop                 = 20
SWEbottom              = 20
MaxSnowLayersMiddle    = 4
IrriducibleWatSatSnow  = 0.02
DrySnowDefRate         = 1
SnowDensityCutoff      = 100
WetSnowDefRate         = 1.5
SnowViscosity          = 1e+06
BlowingSnow            = 0
WindCompaction1D       = 0
InitSWE                = 0

!--- Vegetazione (CanopyFraction = 0 nella variante senza_chioma) -------------------
NumLandCoverTypes = 1
VegHeight         = 250.0
ThresSnowVegUp    = 150.0
LSAI              = 4.1
CanopyFraction    = 0.0
DecayCoeffCanopy  = 2.7
VegSnowBurying    = 1.5
RootDepth         = 150.0
VegReflNIR        = 0.45
VegTransNIR       = 0.3
LeafAngles        = 0.0
CanDensSurface    = 3.6

!--- Suolo -------------------------------------------------------------------------
SoilParFile                 = "soil/soil"
SoilLayerTypes              = 1
HeaderSoilDz                = "Dz"
HeaderThetaRes              = "res"
HeaderThetaSat              = "sat"
HeaderAlpha                 = "a"
HeaderN                     = "n"
HeaderKthSoilSolids         = "thermcond"
HeaderCthSoilSolids         = "thermcap"
HeaderSoilInitPres          = "InitPres"
HeaderSoilInitTemp          = "InitTemp"
FreeDrainageAtLateralBorder = 1
PointDepthFreeSurface       = 250
BottomBoundaryHeatFlux      = 0
MinRatioKactualToKSat       = 1e-08

!--- Uscite --------------------------------------------------------------------------
DtPlotPoint      = 1
PointOutputFile  = "output-tabs/point"
PointAll         = 1
SoilAll          = 1
SnowAll          = 1
SoilPlotDepths   = 0, 100, 200, 500, 1000, 1500, 2000, 4000, 7000, 10000
SoilAveragedTempProfileFile       = "output-tabs/ground"
SoilAveragedIceContentProfileFile = "output-tabs/thetaice"
SoilAveragedLiqContentProfileFile = "output-tabs/thetaliq"
SoilTempProfileFile               = "output-tabs/soilTz"
SnowDepthLayersFile               = "output-tabs/snowDepth"
SnowTempProfileFile               = "output-tabs/snowT"
SnowIceContentProfileFile         = "output-tabs/snowIce"
SnowLiqContentProfileFile         = "output-tabs/snowLiq"
